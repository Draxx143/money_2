class TestPointDialog(Gtk.Dialog):
    def __init__(self, parent, board, tp=None, preset_ref=None, preset_pad=None, preset_net=None):
        title = "Edit Test Point" if tp else "Add Test Point"
        super().__init__(title=title, transient_for=parent, modal=True, use_header_bar=True)
        self.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                         Gtk.STOCK_OK, Gtk.ResponseType.OK)
        self.board = board
        self.tp = tp

        grid = Gtk.Grid(row_spacing=6, column_spacing=12, margin=12)
        self.get_content_area().add(grid)

        self.label_entry = Gtk.Entry()
        self.ref_entry = Gtk.Entry()
        self.pad_entry = Gtk.Entry()
        self.net_entry = Gtk.Entry()
        self.category_combo = Gtk.ComboBoxText()
        for c in ALL_CATEGORIES:
            self.category_combo.append_text(c)
        self.category_combo.set_active(0)
        self.expected_entry = Gtk.Entry()
        self.actual_entry = Gtk.Entry()
        self.unit_entry = Gtk.Entry()
        self.tolerance_entry = Gtk.Entry()
        self.status_combo = Gtk.ComboBoxText()
        for s in ALL_STATUSES:
            self.status_combo.append_text(s)
        self.status_combo.set_active(0)
        self.instrument_entry = Gtk.Entry()
        self.notes_view = Gtk.TextView()
        self.notes_view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
        notes_scroll = Gtk.ScrolledWindow()
        notes_scroll.set_min_content_height(60)
        notes_scroll.add(self.notes_view)

        rows = [
            ("Label:", self.label_entry),
            ("Reference:", self.ref_entry),
            ("Pad #:", self.pad_entry),
            ("Net:", self.net_entry),
            ("Category:", self.category_combo),
            ("Expected:", self.expected_entry),
            ("Actual:", self.actual_entry),
            ("Unit:", self.unit_entry),
            ("Tolerance:", self.tolerance_entry),
            ("Status:", self.status_combo),
            ("Instrument:", self.instrument_entry),
            ("Notes:", notes_scroll),
        ]
        for i, (label, widget) in enumerate(rows):
            lbl = Gtk.Label(label=label, xalign=0)
            lbl.get_style_context().add_class("dim")
            grid.attach(lbl, 0, i, 1, 1)
            grid.attach(widget, 1, i, 1, 1)

        if tp:
            self.label_entry.set_text(tp.label)
            self.ref_entry.set_text(tp.reference)
            self.pad_entry.set_text(tp.pad_number)
            self.net_entry.set_text(tp.net)
            idx = ALL_CATEGORIES.index(tp.category) if tp.category in ALL_CATEGORIES else 0
            self.category_combo.set_active(idx)
            self.expected_entry.set_text(tp.expected_value)
            self.actual_entry.set_text(tp.actual_value)
            self.unit_entry.set_text(tp.unit)
            self.tolerance_entry.set_text(tp.tolerance)
            idx = ALL_STATUSES.index(tp.status) if tp.status in ALL_STATUSES else 0
            self.status_combo.set_active(idx)
            self.instrument_entry.set_text(tp.instrument)
            self.notes_view.get_buffer().set_text(tp.notes or "")
        else:
            if preset_ref:
                self.ref_entry.set_text(preset_ref)
            if preset_pad:
                self.pad_entry.set_text(preset_pad)
            if preset_net:
                self.net_entry.set_text(preset_net)

        self.show_all()

    def build_tp(self):
        notes_buf = self.notes_view.get_buffer()
        notes = notes_buf.get_text(notes_buf.get_start_iter(),
                                   notes_buf.get_end_iter(), True)
        tp = self.tp or TestPoint()
        tp.label = self.label_entry.get_text().strip()
        tp.reference = self.ref_entry.get_text().strip()
        tp.pad_number = self.pad_entry.get_text().strip()
        tp.net = self.net_entry.get_text().strip()
        tp.category = self.category_combo.get_active_text() or "Generic"
        tp.expected_value = self.expected_entry.get_text().strip()
        tp.actual_value = self.actual_entry.get_text().strip()
        tp.unit = self.unit_entry.get_text().strip()
        tp.tolerance = self.tolerance_entry.get_text().strip()
        tp.status = self.status_combo.get_active_text() or STATUS_NOT_TESTED
        tp.instrument = self.instrument_entry.get_text().strip()
        tp.notes = notes.strip()

        # If board and reference/pad present, resolve coordinates.
        if self.board and tp.reference and tp.pad_number:
            comp = self.board.find_component(tp.reference)
            if comp:
                for pad in comp.pads:
                    if pad.number == tp.pad_number:
                        tp.x = comp.x + pad.x
                        tp.y = comp.y + pad.y
                        break
        return tp


