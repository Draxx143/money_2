        f = Gtk.FileFilter(); f.set_name(pattern); f.add_pattern(pattern); d.add_filter(f)
        p = d.get_filename() if d.run() == Gtk.ResponseType.OK else None
        d.destroy()
        return p

    # ---- Board loading ----
    def load_board(self, path):
        lower = path.lower()
        try:
            if lower.endswith(".kicad_pcb"):
                board = parse_pcb(path)
            elif lower.endswith(".json"):
                board = parse_easyeda_json(path)
            elif lower.endswith(".pcbdoc") or lower.endswith(".prjpcb"):
                # ASCII Altium exports work without the optional altium-monkey
                # package. The parser reports a useful error for binary files
                # if that dependency is missing.
                board = parse_pcbdoc(path)
            else:
                self.show_error(f"Unsupported file extension: {path}\n\n"
                                "Supported formats: .kicad_pcb, .PcbDoc, .PrjPcb, EasyEDA .json")
                return
        except AltiumParserError as exc:
            self.show_error(f"Altium import failed:\n{exc}")
            return
        except Exception as exc:
            self.show_error(f"Failed to parse board:\n{exc}")
            return
        self.board = board
        self.board_path = path
        self.viewer.set_board(board)
        # This supplied Altium ASCII design is a bottom-side board; mirror the
        # complete board view by default so it agrees with the CAD bottom view.
        default_bottom = board.version == "altium-ascii"
        self.side_view_combo.set_active(1 if default_bottom else 0)
        self.viewer.set_view_side("Bottom" if default_bottom else "Top")
        self.refresh_layer_panel()
        self.refresh_component_list()
        self.status_project.set_text(f"Board: {os.path.basename(path)}")
        self.log_label.set_text(
            f"Loaded {len(board.components)} components, {len(board.tracks)} tracks"
        )
        self.clear_inspector()
        if self.store.load_if_exists(path):
            self.log_label.set_text(self.log_label.get_text() +
                                    f" — {len(self.store)} test point(s) loaded")
        self.refresh_testpoints_view()


    def load_pdf(self, path):
        try:
            self.pdf_viewer.load(path)
        except Exception as exc:  # noqa: BLE001
            self.show_error(f"Failed to open PDF:\n{exc}")
            return
        self.bottom_notebook.set_current_page(1)

    # ---- Component list ----
    def refresh_component_list(self):
        self.component_store.clear()
        if not self.board:
            return
        for c in self.board.components:
            self.component_store.append([c.reference, c.value, c.footprint])
        self.component_filter.refilter()

    def on_search_changed(self, _e): self.component_filter.refilter()
    def on_filter_changed(self, _c): self.component_filter.refilter()

    def on_tree_selection_changed(self, selection):
        model, tree_iter = selection.get_selected()
        if tree_iter is None:
            return
        ref = model[tree_iter][0]
        self.viewer.select_component(ref)
        self.show_inspector(ref)

    def on_tree_hover(self, widget, event):
        info = widget.get_path_at_pos(int(event.x), int(event.y))
        if not info:
            self.viewer.set_hover(None); return False
        model = widget.get_model()
        it = model.get_iter(info[0])
        self.viewer.set_hover(model[it][0])
        return False

    def on_tree_leave(self, _w, _e):
        self.viewer.set_hover(None)
        return False

    def on_viewer_selected(self, _v, ref):
        if not ref:
            self.component_view.get_selection().unselect_all()
            self.clear_inspector()
            return
        model = self.component_view.get_model()
        for row in model:
            if row[0] == ref:
                self.component_view.get_selection().select_iter(row.iter)
                self.component_view.scroll_to_cell(row.path, None, False, 0, 0)
                self.show_inspector(ref)
                break

    def show_inspector(self, ref):
        if not self.board:
            self.clear_inspector(); return
        comp = self.board.find_component(ref)
        if not comp:
            self.clear_inspector(); return
        L = self._inspector_labels
        L["reference"].set_text(comp.reference)
        L["value"].set_text(comp.value or "—")
        L["footprint"].set_text(comp.footprint or "—")
        L["layer"].set_text(comp.layer or "—")
        L["position"].set_text(f"({comp.x:.3f}, {comp.y:.3f}) mm")
        L["rotation"].set_text(f"{comp.rotation:.1f}°")
        self.pad_store.clear()
        for p in comp.pads:
            self.pad_store.append([p.number, p.shape,
                                   f"{p.width:.2f} × {p.height:.2f} mm",
                                   ",".join(p.layers) if p.layers else "—",
                                   p.net or "—"])

    def clear_inspector(self):
        for lbl in self._inspector_labels.values():
            lbl.set_text("—")
        if hasattr(self, "pad_store"):
            self.pad_store.clear()

    # ---- Test points ----
    def refresh_testpoints_view(self):
        self.tp_store.clear()
        for tp in self.store:
            _status, reason = evaluate_testpoint(tp)
            self.tp_store.append([
                tp.label, tp.reference, tp.pad_number, tp.net,
                tp.expected_value, tp.actual_value, tp.unit, tp.status,
                reason, tp.id,
            ])

    def _selected_tp(self):
        sel = self.tp_view.get_selection()
        model, it = sel.get_selected()
        if it is None:
            return None
        return self.store.get(model[it][9])

    def on_tp_selection_changed(self, selection):
        model, it = selection.get_selected()
        if it is None:
            self.viewer.set_marker(None, None)
            return
        tp = self.store.get(model[it][9])
        if tp and tp.x is not None:
            self.viewer.set_marker(tp.x, tp.y)

    def on_add_testpoint(self, _w):
        dlg = TestPointDialog(self, self.board)
        if dlg.run() == Gtk.ResponseType.OK:
            tp = dlg.build_tp()
            self.store.add(tp)
            self.refresh_testpoints_view()
        dlg.destroy()

    def on_edit_testpoint(self, _w):
        sel = self._selected_tp()
        if not sel:
            self.show_error("Select a test point first.")
            return
        dlg = TestPointDialog(self, self.board, tp=sel)
        if dlg.run() == Gtk.ResponseType.OK:
            tp = dlg.build_tp()
            self.store.update(tp)
            self.refresh_testpoints_view()
        dlg.destroy()

    def on_delete_testpoint(self, _w):
        sel = self._selected_tp()
        if not sel:
            return
        if self.store.delete(sel.id):
            self.refresh_testpoints_view()

    def on_goto_testpoint(self, _w):
        sel = self._selected_tp()
        if not sel:
            return
        if sel.x is None or sel.y is None:
            self.show_error("This test point has no board coordinates.")
            return
        self.viewer.set_marker(sel.x, sel.y)
        self.viewer.pan_to(sel.x, sel.y)

    def on_add_tp_from_inspector(self, _w):
        sel = self.pad_view.get_selection()
        model, it = sel.get_selected()
        if it is None:
            self.show_error("Select a pad in the Inspector first.")
            return
        ref = self._inspector_labels["reference"].get_text()
        pad = model[it][0]
        net = model[it][4] if model[it][4] != "—" else ""
        dlg = TestPointDialog(self, self.board, preset_ref=ref, preset_pad=pad, preset_net=net)
        if dlg.run() == Gtk.ResponseType.OK:
            tp = dlg.build_tp()
            self.store.add(tp)
            self.refresh_testpoints_view()
        dlg.destroy()

    # ---- Auto-evaluate / Suggest ----
    def on_auto_evaluate(self, _w):
        if not len(self.store):
            self.show_error("No test points to evaluate.")
            return
        for tp in self.store:
            status, _reason = evaluate_testpoint(tp)
            tp.status = status
        self.refresh_testpoints_view()
        counts = summarize_results(self.store.all())
        summary = (
            f"Evaluated {len(self.store)} test point(s): "
            f"{counts[STATUS_PASS]} pass, {counts[STATUS_FAIL]} fail, "
            f"{counts[STATUS_UNKNOWN]} unknown, "
            f"{counts[STATUS_NOT_TESTED]} not tested."
        )
        self.log_label.set_text(summary)

    def on_suggest_for_component(self, _w):
        if not self.board:
            self.show_error("Open a board first.")
            return
        # Determine the currently selected component (inspector or tree)
        ref = self._inspector_labels["reference"].get_text()
        if not ref or ref == "—":
            self.show_error("Select a component first.")
            return
        suggestions = suggest_testpoints_for_component(self.board, ref)
        if not suggestions:
            self.show_error(f"No pads found for {ref}.")
            return
        for tp in suggestions:
            self.store.add(tp)
        self.refresh_testpoints_view()
        self.log_label.set_text(
            f"Added {len(suggestions)} suggested test point(s) for {ref}. "
            f"Fill in the expected values."
        )

    # ---- AI Chat ----
    def on_ai_config(self, _w):
        dlg = Gtk.Dialog(title="AI Settings", transient_for=self, modal=True, use_header_bar=True)
        dlg.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, Gtk.STOCK_OK, Gtk.ResponseType.OK)
        grid = Gtk.Grid(row_spacing=6, column_spacing=12, margin=12)
        dlg.get_content_area().add(grid)

        model_entry = Gtk.Entry(text=self.ollama_client.model)
        host_entry = Gtk.Entry(text=self.ollama_client.host)

        grid.attach(Gtk.Label(label="Ollama URL:", xalign=0), 0, 0, 1, 1)
        grid.attach(host_entry, 1, 0, 1, 1)
        grid.attach(Gtk.Label(label="Model Name:", xalign=0), 0, 1, 1, 1)
        grid.attach(model_entry, 1, 1, 1, 1)

        dlg.show_all()
        if dlg.run() == Gtk.ResponseType.OK:
            self.ollama_client.host = host_entry.get_text().strip()
            self.ollama_client.model = model_entry.get_text().strip()
            self.append_chat("System", f"AI configured to use {self.ollama_client.model} at {self.ollama_client.host}.", "#4DA3FF")
        dlg.destroy()

    def append_chat(self, sender, text, color="#F1F5F9"):
        end_iter = self.chat_buffer.get_end_iter()
        tag = self.chat_buffer.create_tag(None, foreground=color, weight=700 if sender != "AI" else 400)
        self.chat_buffer.insert_with_tags(end_iter, f"[{sender}]\n", tag)

        end_iter = self.chat_buffer.get_end_iter()
        tag_body = self.chat_buffer.create_tag(None, foreground="#F1F5F9")
        self.chat_buffer.insert_with_tags(end_iter, f"{text}\n\n", tag_body)

        # Scroll to bottom
        self.chat_view.scroll_to_iter(self.chat_buffer.get_end_iter(), 0.0, False, 0, 0)

    def on_ai_send(self, _w):
        text = self.ai_entry.get_text().strip()
        if not text:
            return
        self.ai_entry.set_text("")
        self.append_chat("You", text, "#00D1B2")

        self.btn_ai_send.set_sensitive(False)
        self.btn_ai_send.set_label("Thinking…")
        self.append_chat("System", "Analyzing board and measurements…", "#94A3B8")

        def on_result(res):
            # This callback is invoked from the background thread; use GLib.idle_add to safely update UI
            from gi.repository import GLib
            GLib.idle_add(self._handle_ai_response, res)

        ask_ai_async(self.ollama_client, text, self.board, self.store, on_result)

    def _handle_ai_response(self, res):
        self.btn_ai_send.set_sensitive(True)
        self.btn_ai_send.set_label("Send")

        if "error" in res:
            self.append_chat("Error", res["error"], "#9b2226")
            return

        data = res["data"]
        msg = data.get("message", "No message.")
        suspects = data.get("suspect_components", [])
        tests = data.get("suggested_tests", [])

        full_reply = msg
        if tests:
            full_reply += "\n\nSuggested Tests:\n- " + "\n- ".join(tests)

        self.append_chat("AI", full_reply, "#F1F5F9")

        # Auto-highlight suspect components
        if suspects and self.board:
            valid_refs = []
            for ref in suspects:
                if self.board.find_component(ref):
                    valid_refs.append(ref)
                else:
                    self.append_chat("System", f"AI mentioned unknown component: {ref}", "#a07600")

            if valid_refs:
                # If multiple, just highlight the first one for now, or we can add multi-highlight support later.
                # For now, let's select the first one.
                first_ref = valid_refs[0]
                self.viewer.select_component(first_ref)
                self.on_viewer_selected(self.viewer, first_ref)
                self.append_chat("System", f"Highlighted {first_ref} on the board.", "#4DA3FF")

        return False # Remove from idle queue

    # ---- Misc ----
    def on_fit_view(self, _w):
        self.viewer.fit_to_view(); self.viewer.queue_draw()

    def on_flip_board(self, item):
        is_bottom = item.get_active()
        if hasattr(self, "side_view_combo"):
            self.side_view_combo.set_active(1 if is_bottom else 0)
        self.viewer.set_view_side("Bottom" if is_bottom else "Top")
        self.viewer.fit_to_view()
        self.viewer.queue_draw()

    def on_settings(self, _w):
        dlg = Gtk.Dialog(title="Application Settings", transient_for=self, modal=True)
        dlg.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL,
                        Gtk.STOCK_OK, Gtk.ResponseType.OK)
        grid = Gtk.Grid(row_spacing=6, column_spacing=12, margin=12)
        dlg.get_content_area().add(grid)
        name_entry = Gtk.Entry(text=APP_NAME)
        sub_entry = Gtk.Entry(text=APP_SUBTITLE)
        grid.attach(Gtk.Label(label="Application name:", xalign=0), 0, 0, 1, 1)
        grid.attach(name_entry, 1, 0, 1, 1)
        grid.attach(Gtk.Label(label="Subtitle:", xalign=0), 0, 1, 1, 1)
        grid.attach(sub_entry, 1, 1, 1, 1)
        dlg.show_all()
        if dlg.run() == Gtk.ResponseType.OK:
            name = name_entry.get_text().strip() or APP_NAME
            sub = sub_entry.get_text().strip()
            self.set_title(f"{name} — {sub}" if sub else name)
        dlg.destroy()

    def on_about(self, _w):
        d = Gtk.AboutDialog(transient_for=self, modal=True)
        d.set_program_name(APP_NAME); d.set_version(APP_VERSION); d.set_comments(APP_SUBTITLE)
        d.run(); d.destroy()

    def show_error(self, message):
        d = Gtk.MessageDialog(transient_for=self, modal=True,
                              message_type=Gtk.MessageType.ERROR,
                              buttons=Gtk.ButtonsType.OK, text=message)
        d.run(); d.destroy()

    def on_quit(self, _w):
        self.destroy()


class App(Gtk.Application):
    def __init__(self):
        super().__init__(
            application_id="io.github.draxx.pcbanalyzer",
            flags=Gio.ApplicationFlags.HANDLES_OPEN,
        )

    def do_open(self, files, n_files, hint):
        self.activate()
        window = self.get_active_window()
        if window:
            for index, source_file in enumerate(files):
                if index >= n_files:
                    break
                path = source_file.get_path()
                if path:
                    window.load_board(path)

    def do_activate(self):
        w = self.get_active_window()
        if not w:
            w = MainWindow(self)
        w.show_all()

    def do_startup(self):
        Gtk.Application.do_startup(self)
        p = Gtk.CssProvider()
        p.load_from_data(APP_CSS.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def main():
    App().run(sys.argv)


if __name__ == "__main__":
    main()
