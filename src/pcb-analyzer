    def _component_visible(self, model, tree_iter, _data):
        text = self.search_entry.get_text().strip().lower()
        if text:
            if text not in " ".join(str(v) for v in model[tree_iter]).lower():
                return False
        active = self.layer_combo.get_active_id() or "All layers"
        if active in ("F.Cu", "B.Cu") and self.board:
            ref = model[tree_iter][0]
            comp = self.board.find_component(ref)
            if not comp or comp.layer != active:
                return False
        return True

