    def refresh_layer_panel(self):
        """Refresh compact per-layer controls anchored beside Top/Bottom."""
        if not hasattr(self, "layer_list"):
            return
        for child in self.layer_list.get_children():
            self.layer_list.remove(child)
        if not self.viewer.layer_names:
            empty = Gtk.Label(label="Open a board to see its layers.", xalign=0)
            row = Gtk.ListBoxRow(); row.add(empty); self.layer_list.add(row)
            self.layer_list.show_all()
            self.layer_popover_content.show_all()
            self.layer_popover.queue_resize()
            return

        colors = {
            "F.Cu": "#E64545", "B.Cu": "#244DFF", "F.SilkS": "#C8B817",
            "B.SilkS": "#55B82A", "F.Mask": "#800000", "B.Mask": "#A000FF",
            "F.Paste": "#64748B", "B.Paste": "#64748B", "Edge.Cuts": "#E000D5",
            "Multi-Layer": "#929292", "Ratlines": "#F59E0B", "Document": "#CBD5E1",
        }
        selected_row = None
        for layer in self.viewer.layer_names:
            row = Gtk.ListBoxRow()
            row.layer_name = layer
            line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            line.set_margin_start(3); line.set_margin_end(6); line.set_margin_top(2); line.set_margin_bottom(2)
            eye = Gtk.ToggleButton()
            eye.set_relief(Gtk.ReliefStyle.NONE)
            eye.set_size_request(28, 26)
            eye.set_active(layer in self.viewer.visible_layers)
            eye_icon = Gtk.DrawingArea(); eye_icon.set_size_request(18, 18)
            eye_icon.connect("draw", self.draw_eye_icon, eye)
            eye.add(eye_icon)
            eye.set_tooltip_text("Show/hide " + layer)
            eye.connect("toggled", self.on_layer_eye_toggled, layer)
            line.pack_start(eye, False, False, 0)

            swatch = Gtk.DrawingArea(); swatch.set_size_request(13, 13)
            swatch.connect("draw", self.draw_layer_swatch, colors.get(layer, "#64748B"))
            line.pack_start(swatch, False, False, 0)
            name = Gtk.Label(label=layer, xalign=0)
            line.pack_start(name, True, True, 0)
            row.add(line)
            self.layer_list.add(row)
            if layer == self.viewer.active_layer:
                selected_row = row
        self.layer_list.show_all()
        if selected_row:
            self.layer_list.select_row(selected_row)
        self.layer_popover_content.show_all()
        self.layer_popover.queue_resize()

    def draw_eye_icon(self, area, cr, toggle):
        active = toggle.get_active()
        cr.set_source_rgb(*( (0.05, 0.42, 0.68) if active else (0.48, 0.53, 0.60) ))
        cr.set_line_width(1.5)
        cr.set_line_cap(1)
        cr.set_line_join(1)
        cr.move_to(2, 9); cr.curve_to(6, 3, 13, 3, 17, 9); cr.curve_to(13, 15, 6, 15, 2, 9); cr.stroke()
        if active:
            cr.arc(9.5, 9, 2.4, 0, 2 * math.pi); cr.fill()
        else:
            cr.move_to(3, 16); cr.line_to(16, 3); cr.stroke()
        return False

    def draw_layer_swatch(self, _area, cr, color):
        parsed = Gdk.RGBA(); parsed.parse(color)
        cr.set_source_rgba(parsed.red, parsed.green, parsed.blue, parsed.alpha)
        cr.arc(7, 7, 5.5, 0, 2 * math.pi); cr.fill()
        return False

    def on_layer_eye_toggled(self, button, layer):
        self.viewer.set_layer_visible(layer, button.get_active())
        if hasattr(self, "layer_popover"):
            # Redraw eye and update snap targets immediately.
