    def draw_tool_icon(self, area, cr, name):
        """Render small CAD-style monochrome line icons in Cairo."""
        parent = area.get_parent()
        active = isinstance(parent, Gtk.ToggleButton) and parent.get_active()
        cr.set_source_rgb(*( (0.02, 0.40, 0.62) if active else (0.20, 0.27, 0.34) ))
        cr.set_line_width(1.7)
        cr.set_line_cap(1)
        cr.set_line_join(1)
        if name == "select":
            cr.move_to(5, 3); cr.line_to(17, 14); cr.line_to(11, 14); cr.line_to(14, 20); cr.line_to(11, 21); cr.line_to(8, 15); cr.line_to(5, 19); cr.close_path(); cr.fill()
        elif name == "pan":
            cr.move_to(11, 4); cr.line_to(11, 20); cr.move_to(4, 12); cr.line_to(20, 12); cr.stroke()
            for points in (((11,3),(8,7),(14,7)),((21,12),(17,9),(17,15)),((11,21),(8,17),(14,17)),((3,12),(7,9),(7,15))):
                cr.move_to(*points[0]); cr.line_to(*points[1]); cr.line_to(*points[0]); cr.line_to(*points[2]); cr.stroke()
        elif name == "measure":
            cr.move_to(4, 18); cr.line_to(19, 5); cr.stroke()
            for x, y, dx, dy in ((4,18,3,-1),(19,5,1,3)):
                cr.move_to(x-dx, y-dy); cr.line_to(x+dx, y+dy); cr.stroke()
        elif name in ("zoom-in", "zoom-out"):
            cr.arc(10, 10, 6, 0, 6.283); cr.stroke(); cr.move_to(14.5,14.5); cr.line_to(20,20); cr.stroke()
            cr.move_to(7,10); cr.line_to(13,10)
            if name == "zoom-in": cr.move_to(10,7); cr.line_to(10,13)
            cr.stroke()
        elif name == "fit":
            cr.move_to(4,9); cr.line_to(4,4); cr.line_to(9,4); cr.move_to(15,4); cr.line_to(20,4); cr.line_to(20,9)
            cr.move_to(20,15); cr.line_to(20,20); cr.line_to(15,20); cr.move_to(9,20); cr.line_to(4,20); cr.line_to(4,15); cr.stroke()
        elif name == "grid":
            cr.rectangle(4,4,16,16); cr.move_to(9.3,4); cr.line_to(9.3,20); cr.move_to(14.7,4); cr.line_to(14.7,20); cr.move_to(4,9.3); cr.line_to(20,9.3); cr.move_to(4,14.7); cr.line_to(20,14.7); cr.stroke()
        elif name == "zones":
            cr.move_to(4,7); cr.line_to(12,4); cr.line_to(20,8); cr.line_to(18,18); cr.line_to(8,20); cr.close_path(); cr.stroke()
            cr.move_to(7,9); cr.line_to(12,7); cr.line_to(17,10); cr.line_to(15,16); cr.line_to(9,17); cr.close_path(); cr.fill()
        elif name == "layers":
            for y in (5, 10, 15):
                cr.move_to(3, y); cr.line_to(11, y - 4); cr.line_to(20, y); cr.line_to(12, y + 4); cr.close_path(); cr.stroke()
        return False

