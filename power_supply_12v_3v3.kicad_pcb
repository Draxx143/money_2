(kicad_pcb (version 20221018) (generator pcbnew)
  (general (thickness 1.6))
  (paper "A4")
  (layers
    (0 "F.Cu" signal)
    (31 "B.Cu" signal)
    (36 "B.SilkS" user "B.Silkscreen")
    (37 "F.SilkS" user "F.Silkscreen")
    (44 "Edge.Cuts" user)
  )
  (setup (pad_to_mask_clearance 0))

  (footprint "TerminalBlock:TerminalBlock_bornier-2_P5.08mm" (layer "F.Cu")
    (at 100 100)
    (fp_text reference "J1" (at 0 -5) (layer "F.SilkS"))
    (fp_text value "12V_IN" (at 0 5) (layer "F.Fab"))
    (pad "1" thru_hole circle (at -2.54 0) (size 2.5 2.5) (drill 1.0) (layers "*.Cu" "*.Mask"))
    (pad "2" thru_hole circle (at 2.54 0) (size 2.5 2.5) (drill 1.0) (layers "*.Cu" "*.Mask"))
  )

  (footprint "Diode_SMD:D_SMA" (layer "F.Cu")
    (at 110 100)
    (fp_text reference "D1" (at 0 -2) (layer "F.SilkS"))
    (fp_text value "1N4007" (at 0 2) (layer "F.Fab"))
    (pad "1" smd rect (at -1.5 0) (size 1.5 1.8) (layers "F.Cu"))
    (pad "2" smd rect (at 1.5 0) (size 1.5 1.8) (layers "F.Cu"))
  )

  (footprint "Capacitor_SMD:C_1206_3216Metric" (layer "F.Cu")
    (at 120 100)
    (fp_text reference "C1" (at 0 -2) (layer "F.SilkS"))
    (fp_text value "100uF" (at 0 2) (layer "F.Fab"))
    (pad "1" smd rect (at -1.5 0) (size 1.6 1.8) (layers "F.Cu"))
    (pad "2" smd rect (at 1.5 0) (size 1.6 1.8) (layers "F.Cu"))
  )

  (footprint "Package_TO_SOT_SMD:SOT-223-3_TabPin2" (layer "F.Cu")
    (at 130 105)
    (fp_text reference "U1" (at 0 -4) (layer "F.SilkS"))
    (fp_text value "AMS1117-3.3" (at 0 5) (layer "F.Fab"))
    (pad "1" smd rect (at -3.5 -2.3) (size 2.0 1.0) (layers "F.Cu"))
    (pad "2" smd rect (at 0 0) (size 3.5 2.0) (layers "F.Cu"))
    (pad "3" smd rect (at 3.5 -2.3) (size 2.0 1.0) (layers "F.Cu"))
  )

  (footprint "Capacitor_SMD:C_0805_2012Metric" (layer "F.Cu")
    (at 140 100)
    (fp_text reference "C2" (at 0 -2) (layer "F.SilkS"))
    (fp_text value "10uF" (at 0 2) (layer "F.Fab"))
    (pad "1" smd rect (at -0.9 0) (size 1.2 1.4) (layers "F.Cu"))
    (pad "2" smd rect (at 0.9 0) (size 1.2 1.4) (layers "F.Cu"))
  )

  (footprint "Capacitor_SMD:C_0805_2012Metric" (layer "F.Cu")
    (at 150 100)
    (fp_text reference "C3" (at 0 -2) (layer "F.SilkS"))
    (fp_text value "10uF" (at 0 2) (layer "F.Fab"))
    (pad "1" smd rect (at -0.9 0) (size 1.2 1.4) (layers "F.Cu"))
    (pad "2" smd rect (at 0.9 0) (size 1.2 1.4) (layers "F.Cu"))
  )

  (footprint "Resistor_SMD:R_0805_2012Metric" (layer "F.Cu")
    (at 160 100)
    (fp_text reference "R1" (at 0 -2) (layer "F.SilkS"))
    (fp_text value "330R" (at 0 2) (layer "F.Fab"))
    (pad "1" smd rect (at -0.9 0) (size 1.2 1.4) (layers "F.Cu"))
    (pad "2" smd rect (at 0.9 0) (size 1.2 1.4) (layers "F.Cu"))
  )

  (footprint "LED_SMD:LED_0805_2012Metric" (layer "F.Cu")
    (at 170 100)
    (fp_text reference "LED1" (at 0 -2) (layer "F.SilkS"))
    (fp_text value "Green" (at 0 2) (layer "F.Fab"))
    (pad "1" smd rect (at -0.9 0) (size 1.2 1.4) (layers "F.Cu"))
    (pad "2" smd rect (at 0.9 0) (size 1.2 1.4) (layers "F.Cu"))
  )

  (footprint "TerminalBlock:TerminalBlock_bornier-2_P5.08mm" (layer "F.Cu")
    (at 180 100)
    (fp_text reference "J2" (at 0 -5) (layer "F.SilkS"))
    (fp_text value "3.3V_OUT" (at 0 5) (layer "F.Fab"))
    (pad "1" thru_hole circle (at -2.54 0) (size 2.5 2.5) (drill 1.0) (layers "*.Cu" "*.Mask"))
    (pad "2" thru_hole circle (at 2.54 0) (size 2.5 2.5) (drill 1.0) (layers "*.Cu" "*.Mask"))
  )

  ; Board outline (Rectangle)
  (gr_line (start 90 80) (end 190 80) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 190 80) (end 190 120) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 190 120) (end 90 120) (layer "Edge.Cuts") (width 0.1))
  (gr_line (start 90 120) (end 90 80) (layer "Edge.Cuts") (width 0.1))

  ; Main power trace (12V to U1)
  (segment (start 102.54 100) (end 108.5 100) (width 1.0) (layer "F.Cu"))
  (segment (start 111.5 100) (end 118.5 100) (width 1.0) (layer "F.Cu"))
  (segment (start 121.5 100) (end 126.5 105) (width 1.0) (layer "F.Cu"))

  ; 3.3V trace (U1 to components)
  (segment (start 130 105) (end 130 100) (width 0.8) (layer "F.Cu"))
  (segment (start 130 100) (end 139.1 100) (width 0.8) (layer "F.Cu"))
  (segment (start 140.9 100) (end 149.1 100) (width 0.8) (layer "F.Cu"))
  (segment (start 150.9 100) (end 159.1 100) (width 0.8) (layer "F.Cu"))
  (segment (start 160.9 100) (end 169.1 100) (width 0.8) (layer "F.Cu"))
  (segment (start 170.9 100) (end 177.46 100) (width 0.8) (layer "F.Cu"))

  ; Ground trace (simple routing to J1, J2)
  (segment (start 97.46 100) (end 97.46 110) (width 0.8) (layer "F.Cu"))
  (segment (start 182.54 100) (end 182.54 110) (width 0.8) (layer "F.Cu"))
  (segment (start 97.46 110) (end 182.54 110) (width 0.8) (layer "F.Cu"))
)
